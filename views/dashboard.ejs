<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>لوحة التحكم - اختيار السيرفر</title>
    <style>
        body { background-color: #030712; color: #f3f4f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 40px; }
        .container { max-w: 1200px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; padding-bottom: 25px; margin-bottom: 40px; }
        h1 { color: #818cf8; font-size: 28px; font-weight: 900; margin: 0; text-shadow: 0 0 15px rgba(129, 140, 248, 0.4); }
        .logout-btn { background: linear-gradient(135deg, #ef4444, #b91c1c); color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 14px; font-weight: 700; transition: 0.3s; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2); }
        .logout-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(239, 68, 68, 0.4); }
        .server-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px; }
        .server-card { background-color: #0f172a; border: 1px solid #1e293b; padding: 30px; border-radius: 24px; display: flex; flex-direction: column; justify-content: space-between; transition: 0.3s; box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5); }
        .server-card:hover { border-color: #6366f1; transform: translateY(-5px); box-shadow: 0 20px 40px rgba(99, 102, 241, 0.2); }
        .server-info { display: flex; align-items: center; margin-bottom: 25px; }
        .server-icon { width: 60px; height: 60px; border-radius: 18px; border: 2px solid #4f46e5; margin-left: 15px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1e1b4b, #312e81); font-weight: bold; font-size: 22px; color: #c7d2fe; }
        .server-name { font-size: 19px; font-weight: 800; margin: 0; color: #ffffff; }
        .server-id { font-size: 13px; color: #64748b; margin: 4px 0 0 0; }
        .control-btn { display: block; text-align: center; background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; text-decoration: none; font-weight: 700; padding: 14px; border-radius: 16px; transition: 0.3s; box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3); }
        .control-btn:hover { background: linear-gradient(135deg, #4338ca, #4f46e5); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(79, 70, 229, 0.5); }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🔮 لوحة التحكم السيبربانكية</h1>
            <a href="/logout" class="logout-btn">تسجيل الخروج</a>
        </header>
        
        <h2 style="color: #94a3b8; font-size: 18px; margin-bottom: 30px; font-weight: 600;">اختر السيرفر المراد التحكم به:</h2>
        <div class="server-grid">
            <% guilds.forEach(guild => { %>
                <div class="server-card">
                    <div class="server-info">
                        <% if(guild.icon) { %>
                            <img src="https://discordapp.com<%= guild.id %>/<%= guild.icon %>.png" class="server-icon">
                        <% } else { %>
                            <div class="server-icon"><%= guild.name.charAt(0) %></div>
                        <% } %>
                        <div style="margin-right: 15px;">
                            <h3 class="server-name"><%= guild.name %></h3>
                            <p class="server-id">ID: <%= guild.id %></p>
                        </div>
                    </div>
                    <a href="/dashboard/<%= guild.id %>" class="control-btn">دخول الإعدادات والماب ←</a>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>
