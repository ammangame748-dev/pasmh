<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>إعدادات السيرفر</title>
    <script src="https://tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-gray-100 font-sans p-8">
    <div class="max-w-4xl mx-auto bg-gray-900 border border-gray-800 p-8 rounded-3xl shadow-2xl">
        <a href="/dashboard" class="text-indigo-400 hover:underline mb-6 inline-block">← العودة للسيرفرات</a>
        <h2 class="text-2xl font-black mb-8 text-indigo-500">⚙️ تخصيص الرسالة التفاعلية (الماب)</h2>

        <form action="/dashboard/<%= guildId %>/save" method="POST" enctype="multipart/form-data" class="space-y-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold mb-2 text-gray-400">ID روم الإرسال (Channel ID):</label>
                    <input type="text" name="channelId" value="<%= settings.channelId %>" required
                        class="w-full bg-gray-950 border border-gray-800 rounded-xl p-3 focus:outline-none focus:border-indigo-500 text-gray-200">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2 text-gray-400">عنوان الإيمباد (Embed Title):</label>
                    <input type="text" name="title" value="<%= settings.title %>" required
                        class="w-full bg-gray-950 border border-gray-800 rounded-xl p-3 focus:outline-none focus:border-indigo-500 text-gray-200">
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold mb-2 text-gray-400">وصف الإيمباد (Embed Description):</label>
                <textarea name="description" rows="3" required
                    class="w-full bg-gray-950 border border-gray-800 rounded-xl p-3 focus:outline-none focus:border-indigo-500 text-gray-200"><%= settings.description %></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold mb-2 text-gray-400">رفع صورة رئيسية للماب (من جهازك):</label>
                <input type="file" name="image"
                    class="w-full bg-gray-950 border border-gray-800 rounded-xl p-3 file:bg-indigo-600 file:border-none file:px-4 file:py-1 file:rounded-lg file:text-white cursor-pointer">
            </div>

            <hr class="border-gray-800 my-8">
            <h3 class="text-lg font-bold mb-4 text-indigo-400">🔲 إعدادات الأزرار الستة (6 أزرار)</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% for(let i=0; i<6; i++) { %>
                    <div class="bg-gray-950 border border-gray-800 p-4 rounded-2xl space-y-3">
                        <span class="text-xs font-bold bg-indigo-900 text-indigo-300 px-2 py-1 rounded">الزر رقم <%= i+1
                                %></span>
                        <div>
                            <label class="block text-xs mb-1 text-gray-400">اسم الزر:</label>
                            <input type="text" name="btn_label_<%= i %>"
                                value="<%= settings.buttons[i] ? settings.buttons[i].label : '' %>" required
                                class="w-full bg-gray-900 border border-gray-800 rounded-lg p-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs mb-1 text-gray-400">ID ايموجي السيرفر (اختياري):</label>
                            <input type="text" name="btn_emoji_<%= i %>"
                                value="<%= settings.buttons[i] ? settings.buttons[i].emoji : '' %>"
                                placeholder="مثال: 123456789012345678"
                                class="w-full bg-gray-900 border border-gray-800 rounded-lg p-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs mb-1 text-gray-400">الرد الخاص (يظهر للكبس عليه فقط):</label>
                            <textarea name="btn_reply_<%= i %>" rows="2" required
                                class="w-full bg-gray-900 border border-gray-800 rounded-lg p-2 text-sm"><%= settings.buttons[i] ? settings.buttons[i].reply : '' %></textarea>
                        </div>
                    </div>
                    <% } %>
            </div>

            <button type="submit"
                class="w-full bg-indigo-600 hover:bg-indigo-500 py-4 rounded-2xl font-bold text-lg shadow-lg transition-all mt-6">حفظ
                وإرسال الماب إلى السيرفر 🚀</button>
        </form>
    </div>
</body>

</html>