<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pasmh Bot</title>
    <style>
        body {
            background-color: #0f111a; /* خلفية داكنة مريحة */
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        img {
            max-width: 200px; /* حجم الصورة */
            border-radius: 50%; /* لجعل الصورة دائرية */
            box-shadow: 0 0 20px rgba(88, 101, 242, 0.5); /* إضاءة خفيفة حول الصورة */
        }
    </style>
</head>
<body>
    <!-- ضع هنا رابط صورة البوت الخاصة بك مكان الرابط أدناه -->
    <img src="https://discordapp.com" alt="Bot Logo">
</body>
</html>
